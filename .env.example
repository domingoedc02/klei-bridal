# Copy to .env.local for development. Never commit real values —
# .env* is git-ignored. In production every one of these lives in
# Dokploy's environment configuration, never in the repository.
#
# Names here are the single source of truth (src/config/env.ts validates
# them with Zod and the app refuses to boot if a required one is missing
# or malformed). See spec/setup for the full reference table.

NODE_ENV=development
PORT=3000

# --- Datastores --------------------------------------------------------
DATABASE_URL=postgresql://klei:klei_dev_pw@localhost:5432/klei_dev
REDIS_URL=redis://localhost:6379

# --- Sessions / CSRF -----------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=
# Comma-separated version:64-hex-key entries. Keep old keys during rewrap.
STAFF_MAIL_DATA_KEYS=1:
STAFF_MAIL_DATA_KEY_VERSION=1

# --- Site origin ---------------------------------------------------------
# Local/staging only. Production requires client-owned domain and DNS verification.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mail (Resend) ---------------------------------------------------------
# Non-production examples only. Replace every client placeholder before production.
MAIL_PROVIDER_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM_ADDRESS=enquiries@example.test
MAIL_FROM_NAME=Klei Bridal Studio
MAIL_SENDING_DOMAIN=example.test
STUDIO_ENQUIRY_EMAIL=studio@example.test
MAIL_DRY_RUN=true
MAIL_WEBHOOK_SIGNING_SECRET=
ALERT_EMAIL=alerts@example.test

# --- Images (the kbs-media volume; MEDIA_ROOT is dead, do not use it) ---
IMAGE_ORIGINALS_PATH=./.data/images/originals
IMAGE_CACHE_PATH=./.data/images/derivatives
IMAGE_WORKER_CONCURRENCY=2
IMAGE_MAX_UPLOAD_BYTES=26214400
IMAGE_MAX_PER_GOWN=10

# --- Studio bootstrap (seed defaults only — settings table is the
# runtime source of truth once KBS-9 lands) ------------------------------
# Client-provided production timezone currently requested as Asia/Manila.
# Confirm with client before production; do not replace with a guessed timezone.
STUDIO_TIMEZONE=Asia/Manila
DEFAULT_CURRENCY=PHP
# Non-production examples only. Real client values required in production.
MESSENGER_PAGE_HANDLE=example-page-handle
WHATSAPP_NUMBER=639000000000
VIBER_NUMBER=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Seed only (never read at runtime) ------------------------------------
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=
