{
  "name": "klei-bridal",
  "version": "0.1.0",
  "private": true,
  "description": "Klei Bridal Studio — showcase catalogue, enquiry hand-off and staff admin (ORBIT project KBS).",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server drizzle/seed/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.4",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "uuid": "14.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-boundaries": "5.0.1",
    "prettier": "3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "2.1.8"
  }
}
